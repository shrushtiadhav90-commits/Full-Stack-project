# Copy this file to .env in the backend/ directory and fill in real values.
# NEVER commit the real .env file.

DB_URL=jdbc:mysql://localhost:3306/nexus_quiz?serverTimezone=UTC&useUnicode=true&characterEncoding=utf8&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

JWT_SECRET=replace_with_a_strong_64_char_secret_here_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7

FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads

ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin@1234

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
EMAIL_ENABLED=false
